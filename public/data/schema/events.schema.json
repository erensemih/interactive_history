{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aynı Zamanda — olay dosyası",
  "description": "Bir olay kümesi. Yeni olay eklemek için 'events' dizisine bir nesne eklemek yeterlidir; arayüz kod değişikliği gerektirmez.",
  "type": "object",
  "required": ["set", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "set": { "type": "string", "description": "Kümenin kısa adı (global, ottoman, ming, ...)" },
    "title": { "type": "object", "properties": { "tr": { "type": "string" } } },
    "events": { "type": "array", "items": { "$ref": "#/definitions/event" } }
  },
  "definitions": {
    "localized": {
      "type": "object",
      "required": ["tr"],
      "properties": { "tr": { "type": "string", "minLength": 1 } }
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{1,4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
      "description": "YYYY, YYYY-AA veya YYYY-AA-GG"
    },
    "event": {
      "type": "object",
      "required": ["id", "title", "summary", "date", "location", "importance", "category", "parties", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Benzersiz kimlik" },
        "title": { "$ref": "#/definitions/localized" },
        "summary": { "$ref": "#/definitions/localized" },
        "date": {
          "description": "Tek tarih ya da tarih aralığı. 'approximate' yaklaşık tarihleri 'yak.' ile gösterir.",
          "oneOf": [
            { "$ref": "#/definitions/isoDate" },
            {
              "type": "object",
              "required": ["start"],
              "properties": {
                "start": { "$ref": "#/definitions/isoDate" },
                "end": { "$ref": "#/definitions/isoDate" },
                "approximate": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        },
        "location": {
          "type": "object",
          "required": ["name", "coordinates"],
          "properties": {
            "name": { "$ref": "#/definitions/localized" },
            "coordinates": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2,
              "description": "[boylam, enlem]"
            }
          }
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "5 dönüm noktası · 4 çok önemli · 3 önemli (haritada görünür) · 2 yerel önem · 1 yerel ayrıntı (yalnızca çizelgede)"
        },
        "category": { "type": "string", "description": "categories.json içindeki kimliklerden biri" },
        "parties": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "entities.json içindeki devlet/bölge kimlikleri. Olay, bu tarafların zaman çizelgesinde mesafeden bağımsız görünür."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "wikipedia": { "type": "string", "description": "Makale başlığı (varsayılan dil: en)" },
              "lang": { "type": "string" },
              "wikidata": { "type": "string", "pattern": "^Q\\d+$" },
              "url": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
